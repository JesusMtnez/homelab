{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "🤖 Renovate Dashboard 🤖",
  "rebaseWhen": "conflicted",
  "ignorePaths": [ "**/archive/**", "**/kubernetes/apps/**", "**/*.sops.*"],
  "ignoreDeps": [ "linuxserver/transmission" ],
  "kubernetes": {
    "fileMatch": [
      "kubernetes/.+\\.ya?ml$"
    ]
  },
  "helm-values": {
    "fileMatch": [
      "(^|/)kubernetes/.+\\.ya?ml(?:\\.j2)?$"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Process custom dependencies",
      "fileMatch": [
        "(^|/)kubernetes/.+\\.ya?ml(?:\\.j2)?$"
      ],
      "matchStrings": [
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( repository=(?<registryUrl>\\S+))?\\n.+: (&\\S+\\s)?(?<currentValue>\\S+)",
        "datasource=(?<datasource>\\S+)\n.*?repo: (?<registryUrl>\\S+)\n.*?chart: (?<depName>\\S+)\n.*?version: (?<currentValue>\\S+)\n"
      ],
      "datasourceTemplate": "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}"
    },
    {
      "customType": "regex",
      "description": "Docsify CDN versions in HTML",
      "fileMatch": [
        "(^|/)docs/index\\.html$"
      ],
      "matchStrings": [
        "cdn\\.jsdelivr\\.net/npm/(?<depName>[^/@]+)@(?<currentValue>[^/]+)/"
      ],
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "Flux Operator chart version in the git-managed HelmRelease",
      "fileMatch": [
        "(^|/)kubernetes/fluffy/infra/flux-operator/helmrelease\\.ya?ml$"
      ],
      "matchStrings": [
        "chart: (?<depName>flux-operator)\\s+version: \"?(?<currentValue>v?\\d+\\.\\d+\\.\\d+)"
      ],
      "registryUrlTemplate": "oci://ghcr.io/controlplaneio-fluxcd/charts",
      "datasourceTemplate": "helm",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Flux controllers version in the FluxInstance",
      "fileMatch": [
        "(^|/)kubernetes/fluffy/infra/flux-operator/fluxinstance\\.ya?ml$"
      ],
      "matchStrings": [
        "version: (?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "fluxcd/flux2",
      "datasourceTemplate": "github-tags",
      "extractVersionTemplate": "^v(?<version>.*)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Flux version badge in the READMEs (kept in sync with the FluxInstance)",
      "fileMatch": [
        "(^|/)README\\.md$"
      ],
      "matchStrings": [
        "fluxcd-badge]: https://img\\.shields\\.io/badge/(?<currentValue>\\d+\\.\\d+\\.\\d+)-blue"
      ],
      "depNameTemplate": "fluxcd/flux2",
      "datasourceTemplate": "github-tags",
      "extractVersionTemplate": "^v(?<version>.*)$",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": ["Custom versioning for k3s"],
      "matchDatasources": ["github-releases"],
      "matchPackagePatterns": ["k3s"],
      "versioning": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?<compatibility>\\+k3s)(?<build>\\d+)$"
    },
    {
      "enabled": true,
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "fireflyiii/core",
        "fireflyiii/data-importer"
      ],
      "versioning": "regex:^version-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)?$",
      "commitMessageTopic": "image {{depName}}",
      "commitMessageExtra": "to {{#if isSingleVersion}}{{{newVersion}}}{{else}}{{{newValue}}}{{/if}}"
    },
    {
      "enabled": true,
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/linuxserver/bookstack"
      ],
      "versioning": "regex:^v?(?<major>\\d+)\\.?(?<minor>\\d+)?\\.?(?<patch>\\d+)?-ls(?<build>\\d+)$",
      "commitMessageTopic": "image {{depName}}",
      "commitMessageExtra": "to {{#if isSingleVersion}}{{{newVersion}}}{{else}}{{{newValue}}}{{/if}}"
    },
    {
      "enabled": true,
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch"
      ],
      "commitMessageTopic": "image {{depName}}",
      "commitMessageExtra": "to {{#if isSingleVersion}}{{{newVersion}}}{{else}}{{{newValue}}}{{/if}}"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "labels": [
        "renovate/container"
      ]
    },
    {
      "matchDatasources": [
        "helm"
      ],
      "addLabels": [
        "renovate/helm"
      ]
    },
    {
      "matchDatasources": [
        "github-releases",
        "github-tags"
      ],
      "addLabels": [
        "renovate/github-release"
      ]
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "addLabels": [
        "renovate/github-action"
      ]
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "labels": [
        "dep/major"
      ]
    },
    {
      "matchUpdateTypes": [
        "minor"
      ],
      "labels": [
        "dep/minor"
      ]
    },
    {
      "matchUpdateTypes": [
        "patch"
      ],
      "labels": [
        "dep/patch"
      ],
      "automerge": true
    },
    {
      "matchDatasources": [
        "npm"
      ],
      "commitMessageTopic": "package {{depName}}",
      "commitMessageExtra": "to {{#if isSingleVersion}}{{{newVersion}}}{{else}}{{{newValue}}}{{/if}}"
    }
  ]
}
